# ---- AI provider ----
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Free tier ----
FREE_DAILY_LIMIT=3
LIVE_DAILY_LIMIT=2
RECRUITER_FREE_JOBS_DAILY=5
RECRUITER_FREE_RANK_RUNS_DAILY=5
RECRUITER_FREE_INTERVIEWS_DAILY=5
JOB_AGENT_FREE_RUNS_DAILY=5

# ---- Google sign-in ----
GOOGLE_CLIENT_ID=
AUTH_SESSION_SECRET=
RECRUITER_AUTH_SESSION_DAYS=30

# ---- Stripe billing (test/live switch) ----
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PRICE_ID=
STRIPE_LIVE_WEBHOOK_SECRET=
MEMBERSHIP_TRIAL_DAYS=7
MEMBERSHIP_REFERRAL_REWARD_DAYS=7

# ---- Postgres ----
DATABASE_URL=
SMARTJOBS_DATABASE_URL=
PGSSL=false

# ---- Job-search agent ----
APP_BASE_URL=https://your-smartjobs-domain.example
JOB_AGENT_SCHEDULER_ENABLED=true
JOB_AGENT_SCHEDULER_INTERVAL_MINUTES=15
JOB_AGENT_SCHEDULER_BATCH_SIZE=4
JOB_AGENT_MAX_QUERIES=24
JOB_AGENT_MAX_DISCOVERED=100
JOB_AGENT_QUERY_CONCURRENCY=3
JOB_AGENT_VERIFY_CONCURRENCY=5
JOB_AGENT_SEARCH_TIMEOUT_MS=10000
JOB_AGENT_SEARCH_PROVIDER=auto
JOB_AGENT_SEARCH_RSS_URL=https://www.bing.com/search
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---- SMTP: agent digests and referral invitations ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartJobs <jobs@yourdomain.com>
SMTP_FROM_ADDRESS=jobs@yourdomain.com
SMTP_HELO_NAME=smartjobs.yourdomain.com

PORT=3000
