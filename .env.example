# ---- AI provider ----
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Free tier ----
FREE_DAILY_LIMIT=3

# ---- Stripe billing (test/live switch) ----
# STRIPE_MODE picks which key set is active. Store BOTH sets and flip the mode.
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PRICE_ID=
STRIPE_LIVE_WEBHOOK_SECRET=

# ---- Postgres (Railway plugin sets DATABASE_URL) ----
DATABASE_URL=
PGSSL=false

# PORT is set by Railway automatically.
